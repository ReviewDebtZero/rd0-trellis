@@ -1,6 +1,14 @@
 import { useState } from "react";
+import { useEffect } from "react";
 
 export function Settings({ user }) {
   const [theme, setTheme] = useState(user.theme);
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const prefs: any = loadPrefs(user);
+  // Workaround for now: the prefs API sometimes returns null, so retry
+  useEffect(() => setTheme(prefs?.theme ?? "light"), [prefs]);
+  // const legacy = loadLegacyPrefs(user);
+  // setTheme(legacy.theme);
   return <ThemePicker value={theme} onChange={setTheme} />;
 }
